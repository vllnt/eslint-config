{
  "name": "@vllnt/eslint-config",
  "version": "2.2.0",
  "type": "module",
  "description": "Strict ESLint config for TypeScript projects. All rules enforce error — no warnings.",
  "license": "MIT",
  "main": "./flat/index.js",
  "homepage": "https://oss.vllnt.com/packages/eslint-config",
  "repository": {
    "type": "git",
    "url": "https://github.com/vllnt/eslint-config"
  },
  "keywords": [
    "eslint",
    "eslint-config",
    "typescript",
    "react",
    "nextjs",
    "prettier",
    "flat-config",
    "convex",
    "playwright",
    "turborepo"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.9",
  "files": [
    "flat",
    "CHANGELOG.md",
    "llms.txt"
  ],
  "exports": {
    ".": "./flat/index.js",
    "./nextjs": "./flat/nextjs.js",
    "./nodejs": "./flat/nodejs.js",
    "./convex": "./flat/convex.js",
    "./react": "./flat/react.js",
    "./turbo": "./flat/turbo.js",
    "./boundaries": "./flat/boundaries.js",
    "./playwright": "./flat/playwright.js",
    "./ignores": "./flat/ignores.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "pnpm check:agents && node --test tests/*.test.js && pnpm test:eslint10",
    "check:agents": "node -e \"const f=require('node:fs');if(!f.existsSync('AGENTS.md')||f.existsSync('CLAUDE.md')||f.existsSync('.claude'))process.exit(1)\"",
    "test:eslint10": "LINT_ESLINT=eslint10 node --test tests/smoke.test.js tests/lint-behavior.test.js tests/convex-rules.test.js"
  },
  "dependencies": {
    "@convex-dev/eslint-plugin": "^5.0.1",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.4.6",
    "eslint-plugin-boundaries": "^5.4.0",
    "eslint-plugin-css-modules": "^2.12.0",
    "eslint-plugin-functional": "^10.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.14.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-turbo": "^2.11.13",
    "eslint-plugin-unicorn": "^65.0.1",
    "eslint-plugin-write-good-comments": "^0.2.0",
    "typescript-eslint": "8.73.0"
  },
  "peerDependencies": {
    "eslint": ">=9",
    "prettier": ">=3",
    "typescript": ">=6.0.2 <6.1"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "convex": "^1.51.0",
    "eslint": "^9.39.5",
    "eslint10": "npm:eslint@^10.15.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "pnpm": {
    "minimumReleaseAge": 10080,
    "minimumReleaseAgeExclude": [
      "@vllnt/*"
    ],
    "ignoredBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "handlebars": ">=4.7.10",
      "deepmerge-ts@<8.0.0": "^8.0.2",
      "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
    }
  }
}
