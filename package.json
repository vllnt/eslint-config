{
  "name": "@vllnt/eslint-config",
  "version": "2.0.0",
  "type": "module",
  "description": "Strict ESLint config for TypeScript projects. All rules enforce error — no warnings.",
  "license": "MIT",
  "main": "./flat/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/vllnt/eslint-config"
  },
  "keywords": [
    "eslint",
    "eslint-config",
    "typescript",
    "react",
    "nextjs",
    "prettier"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "packageManager": "pnpm@10.28.2",
  "files": [
    "flat"
  ],
  "exports": {
    ".": "./flat/index.js",
    "./nextjs": "./flat/nextjs.js",
    "./nodejs": "./flat/nodejs.js",
    "./convex": "./flat/convex.js",
    "./react": "./flat/react.js",
    "./turbo": "./flat/turbo.js",
    "./boundaries": "./flat/boundaries.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "prepublishOnly": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@convex-dev/eslint-plugin": "^3.0.0",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "7.2.x",
    "eslint-plugin-css-modules": "^2.12.0",
    "eslint-plugin-functional": "^10.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-turbo": "2.10.9",
    "eslint-plugin-unicorn": "65.x",
    "eslint-plugin-write-good-comments": "^0.2.0",
    "typescript-eslint": "8.67.x"
  },
  "peerDependencies": {
    "eslint": ">=9.38 <10",
    "prettier": ">=3",
    "typescript": ">=5 <6.1"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "convex": "^1.43.0",
    "eslint": "^9.39.5",
    "react": "19.2.8",
    "turbo": "2.10.9",
    "typescript": "^5.9.3"
  }
}
